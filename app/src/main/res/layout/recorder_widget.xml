<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widgetOpenApp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recorder_widget_title"
            android:textColor="@color/voice_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textWidgetStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/recorder_widget_idle"
            android:textColor="@color/voice_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textWidgetElapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/recorder_widget_elapsed_description"
            android:text="@string/recorder_widget_zero_time"
            android:textColor="@color/voice_text"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/buttonWidgetPrimary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/widget_action_start"
            android:contentDescription="@string/recorder_widget_primary_description"
            android:gravity="center"
            android:text="@string/recorder_widget_start"
            android:textColor="@color/voice_on_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonWidgetSecondary"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_action_secondary"
            android:contentDescription="@string/recorder_widget_secondary_description"
            android:gravity="center"
            android:text="@string/recorder_widget_ai"
            android:textColor="@color/voice_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
